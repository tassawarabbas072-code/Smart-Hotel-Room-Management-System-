#include <iostream>
#include <string>
#include <cctype>
using namespace std;

class Hotel {
private:
    static const int TOTAL_ROOMS = 100;

    int roomNo[TOTAL_ROOMS];
    bool isBooked[TOTAL_ROOMS];
    int roomType[TOTAL_ROOMS];
    int stayDays[TOTAL_ROOMS];

    string customerName[TOTAL_ROOMS];
    string idNumber[TOTAL_ROOMS];   // CNIC or Passport
    string phone[TOTAL_ROOMS];
    string email[TOTAL_ROOMS];
    string country[TOTAL_ROOMS];
    string city[TOTAL_ROOMS];
    string paymentMethod[TOTAL_ROOMS];

    string feedbacks[100];
    int totalCustomers;
    int feedbackCount;

public:

    Hotel() {
        for (int i = 0; i < TOTAL_ROOMS; i++) {
            roomNo[i] = i + 1;
            isBooked[i] = false;
            roomType[i] = 0;
            stayDays[i] = 0;
        }
        totalCustomers = 0;
        feedbackCount = 0;
    }

    // ✅ CNIC Validation (xxxxx-xxxxxxx-x)
    bool validCNIC(string c) {
        if (c.length() != 15) return false;

        for (int i = 0; i < 15; i++) {
            if (i == 5 || i == 13) {
                if (c[i] != '-') return false;
            } else {
                if (!isdigit(c[i])) return false;
            }
        }
        return true;
    }

    // ✅ Passport Validation
    bool validPassport(string p) {
        if (p.length() < 6) return false;

        for (int i = 0; i < p.length(); i++)
            if (!isalnum(p[i])) return false;

        return true;
    }

    // ✅ Phone Validation
    bool validPhone(string p) {

        if (p.length() < 5) return false;

        // International (+)
        if (p[0] == '+') {
            for (int i = 1; i < p.length(); i++)
                if (!isdigit(p[i])) return false;
            return true;
        }

        // Pakistani 03XXXXXXXXX
        if (p.length() == 11 && p[0]=='0' && p[1]=='3') {
            for (int i = 0; i < 11; i++)
                if (!isdigit(p[i])) return false;
            return true;
        }

        return false;
    }

    // ✅ Email Validation
    bool validEmail(string e) {
        if (e.find('@') == string::npos) return false;
        if (e.find('.') == string::npos) return false;
        return true;
    }

    // 1️⃣ Room Availability
    void checkAvailability() {
        cout << "\nAvailable Rooms:\n";
        for (int i = 0; i < TOTAL_ROOMS; i++) {
            if (!isBooked[i])
                cout << "Room " << roomNo[i] << " Available\n";
        }
    }

    // 2️⃣ Smart Recommendation
    void smartRecommendation() {
        int budget;
        cout << "\nEnter Your Budget Per Day: ";
        cin >> budget;

        if (budget <= 3000)
            cout << "Recommended: Single Room (3000 PKR)\n";
        else if (budget <= 5000)
            cout << "Recommended: Double Room (5000 PKR)\n";
        else
            cout << "Recommended: Deluxe Room (8000 PKR)\n";
    }

    // 3️⃣ Online Booking (International Enabled)
    void onlineBooking() {

        int r, type, days;
        string nationality;

        cout << "\nEnter Room Number (1-100): ";
        cin >> r;

        if (r < 1 || r > TOTAL_ROOMS || isBooked[r-1]) {
            cout << "Invalid or Already Booked Room!\n";
            return;
        }

        cin.ignore();

        cout << "Enter Nationality (Pakistan / Other): ";
        getline(cin, nationality);

        cout << "Enter Full Name: ";
        getline(cin, customerName[r-1]);

        // Pakistani
        if (nationality == "Pakistan" || nationality == "pakistan") {

            do {
                cout << "Enter CNIC (xxxxx-xxxxxxx-x): ";
                getline(cin, idNumber[r-1]);

                if (!validCNIC(idNumber[r-1]))
                    cout << "Invalid CNIC Format! Try Again.\n";

            } while (!validCNIC(idNumber[r-1]));
        }
        else {  // Foreign

            do {
                cout << "Enter Passport Number: ";
                getline(cin, idNumber[r-1]);

                if (!validPassport(idNumber[r-1]))
                    cout << "Invalid Passport! Try Again.\n";

            } while (!validPassport(idNumber[r-1]));
        }

        // Phone
        do {
            cout << "Enter Phone (+CountryCode or 03XXXXXXXXX): ";
            getline(cin, phone[r-1]);

            if (!validPhone(phone[r-1]))
                cout << "Invalid Phone! Try Again.\n";

        } while (!validPhone(phone[r-1]));

        // Email
        do {
            cout << "Enter Email: ";
            getline(cin, email[r-1]);

            if (!validEmail(email[r-1]))
                cout << "Invalid Email! Try Again.\n";

        } while (!validEmail(email[r-1]));

        cout << "Enter Country: ";
        getline(cin, country[r-1]);

        cout << "Enter City: ";
        getline(cin, city[r-1]);

        cout << "Enter Stay Days: ";
        cin >> days;

        cout << "Select Room Type (1=Single 2=Double 3=Deluxe): ";
        cin >> type;

        cin.ignore();
        cout << "Enter Payment Method (Cash/Card/Online): ";
        getline(cin, paymentMethod[r-1]);

        stayDays[r-1] = days;
        roomType[r-1] = type;
        isBooked[r-1] = true;
        totalCustomers++;

        generateBill(type, days);

        cout << "\nRoom Successfully Booked!\n";
    }

    // 4️⃣ Bill Generation
    void generateBill(int type, int days) {

        int price = 0;

        if (type == 1) price = 3000;
        else if (type == 2) price = 5000;
        else if (type == 3) price = 8000;

        cout << "\n===== BILL DETAILS =====\n";
        cout << "Total Amount: " << price * days << " PKR\n";
    }

    // 5️⃣ Checkout
    void checkout() {
        int r;

        cout << "\nEnter Room Number to Checkout: ";
        cin >> r;

        if (r < 1 || r > TOTAL_ROOMS || !isBooked[r-1]) {
            cout << "Invalid Room!\n";
            return;
        }

        isBooked[r-1] = false;
        cout << "Checkout Successful!\n";
    }

    // 6️⃣ Customer History
    void customerHistory() {
        cout << "\nTotal Customers So Far: " << totalCustomers << endl;
    }

    // 7️⃣ Feedback
    void feedbackSystem() {
        cin.ignore();
        cout << "Enter Feedback: ";
        getline(cin, feedbacks[feedbackCount]);
        feedbackCount++;
        cout << "Thank You For Feedback!\n";
    }
};

int main() {

    Hotel h;
    int choice;

    do {
        cout << "\n===== SMART HOTEL ROOM MANAGEMENT SYSTEM =====\n";
        cout << "1. Check Room Availability\n";
        cout << "2. Smart Room Recommendation\n";
        cout << "3. Online Booking\n";
        cout << "4. Checkout\n";
        cout << "5. Customer History\n";
        cout << "6. Feedback System\n";
        cout << "0. Exit\n";
        cout << "Enter Choice: ";
        cin >> choice;

        switch(choice) {
            case 1: h.checkAvailability(); break;
            case 2: h.smartRecommendation(); break;
            case 3: h.onlineBooking(); break;
            case 4: h.checkout(); break;
            case 5: h.customerHistory(); break;
            case 6: h.feedbackSystem(); break;
            case 0: cout << "Thank You!\n"; break;
            default: cout << "Invalid Choice!\n";
        }

    } while(choice != 0);

    return 0;
}