// =====================================================
// DATE FUNCTION
// =====================================================

string getCurrentDate()
{
    time_t now = time(0);
    tm *ltm = localtime(&now);

    return to_string(ltm->tm_mday) + "/" +
           to_string(ltm->tm_mon + 1) + "/" +
           to_string(ltm->tm_year + 1900);
}

// =====================================================
// DAY FUNCTION
// =====================================================

string getCurrentDay()
{
    string days[] =
    {
        "Sunday",
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday"
    };

    time_t now = time(0);
    tm *ltm = localtime(&now);

    return days[ltm->tm_wday];
}

// =========================================================
//                  BASE CLASS : PERSON
// =========================================================
class Person {

protected:

    string name;
    string phone;
    string email;
    string country;
    string city;

public:

    Person() {

        name = "";
        phone = "";
        email = "";
        country = "";
        city = "";
    }

    // =====================================================
    // NAME VALIDATION
    // =====================================================
    bool validName(string str) {

        for (char c : str) {

            if (!isalpha(c) && c != ' ')
                return false;
        }

        return !str.empty();
    }

    // =====================================================
    // PHONE VALIDATION
    // =====================================================
    bool validPhone(string str) {

        if (str.length() != 11)
            return false;

        for (char c : str) {

            if (!isdigit(c))
                return false;
        }

        return true;
    }

    // =====================================================
    // EMAIL VALIDATION
    // =====================================================
    bool validEmail(string str) {

        return str.find('@') != string::npos
            && str.find(".com") != string::npos;
    }

    // =====================================================
    // INPUT PERSON DATA
    // =====================================================
    virtual void inputPersonData() {

        cin.ignore();

        // NAME
        do {

            cout << "Enter Name: ";
            getline(cin, name);

            if (!validName(name))
                cout << "Invalid Name Enter Again\n";

        } while (!validName(name));

        // PHONE
        do {

            cout << "Enter Phone: ";
            getline(cin, phone);

            if (!validPhone(phone))
                cout << "Invalid Phone Number Enter Again\n";

        } while (!validPhone(phone));

        // EMAIL
        do {

            cout << "Enter Email: ";
            getline(cin, email);

            if (!validEmail(email))
                cout << "Invalid Email Enter Again\n";

        } while (!validEmail(email));

        // COUNTRY
        do {

            cout << "Enter Country: ";
            getline(cin, country);

            if (!validName(country))
                cout << "Invalid Country Enter Again\n";

        } while (!validName(country));

        // CITY
        do {

            cout << "Enter City: ";
            getline(cin, city);

            if (!validName(city))
                cout << "Invalid City Enter Again\n";

        } while (!validName(city));
    }

    // =====================================================
    // DISPLAY PERSON DATA
    // =====================================================
    virtual void displayPersonData() {

        cout << left << setw(15)
             << "Name"
             << ": " << name << endl;

        cout << left << setw(15)
             << "Phone"
             << ": " << phone << endl;

        cout << left << setw(15)
             << "Email"
             << ": " << email << endl;

        cout << left << setw(15)
             << "Country"
             << ": " << country << endl;

        cout << left << setw(15)
             << "City"
             << ": " << city << endl;
    }

    virtual ~Person() {}
};

// =========================================================
//                  CUSTOMER CLASS
// =========================================================
class Customer : public Person {

private:

    string idNumber;
    string nationality;

public:

    Customer() {

        idNumber = "";
        nationality = "";
    }

    // =====================================================
    // CNIC VALIDATION
    // =====================================================
    bool validCNIC(string str) {

        if (str.length() != 13)
            return false;

        for (char c : str) {

            if (!isdigit(c))
                return false;
        }

        return true;
    }

    // =====================================================
    // PASSPORT VALIDATION
    // =====================================================
    bool validPassport(string str) {

        return str.length() >= 6;
    }

    // =====================================================
    // CUSTOMER INPUT
    // =====================================================
    void inputCustomerData() {

        inputPersonData();

        do {

            cout << "Enter Nationality: ";
            getline(cin, nationality);

            if (nationality.empty())
                cout << "Invalid Nationality Enter Again\n";

        } while (nationality.empty());

        // PAKISTANI CUSTOMER
        if (nationality == "Pakistani" ||
            nationality == "pakistani" ||
            nationality == "PAKISTANI") {

            do {

                cout << "Enter CNIC (13 Digits): ";
                getline(cin, idNumber);

                if (!validCNIC(idNumber))
                    cout << "Invalid CNIC Enter Again\n";

            } while (!validCNIC(idNumber));
        }

        // FOREIGN CUSTOMER
        else {

            do {

                cout << "Enter Passport Number: ";
                getline(cin, idNumber);

                if (!validPassport(idNumber))
                    cout << "Invalid Passport Enter Again\n";

            } while (!validPassport(idNumber));
        }
    }

    // =====================================================
    // DISPLAY CUSTOMER DATA
    // =====================================================
    void displayCustomerData() {

        displayPersonData();

        cout << left << setw(15)
             << "Nationality"
             << ": " << nationality << endl;

        if (nationality == "Pakistani" ||
            nationality == "pakistani" ||
            nationality == "PAKISTANI") {

            cout << left << setw(15)
                 << "CNIC"
                 << ": " << idNumber << endl;
        }

        else {

            cout << left << setw(15)
                 << "Passport"
                 << ": " << idNumber << endl;
        }
    }
};

// =========================================================
//                  ROOM ABSTRACT CLASS
// =========================================================
class Room {

protected:

    int roomNo;
    bool booked;
    int stayDays;
    string bookingDate;

public:

    Room() {

        roomNo = 0;
        booked = false;
        stayDays = 0;
        bookingDate = "";
    }

    virtual void setRoom(int no) {

        roomNo = no;
    }

    virtual int getPrice() = 0;

    virtual string getRoomType() = 0;

    bool isBooked() {

        return booked;
    }

    void bookRoom(int days, string date) {

        booked = true;
        stayDays = days;
        bookingDate = date;
    }

    void checkoutRoom() {

        booked = false;
        stayDays = 0;
        bookingDate = "";
    }

    int getRoomNo() {

        return roomNo;
    }

    int getStayDays() {

        return stayDays;
    }

    string getBookingDate() {

        return bookingDate;
    }

    virtual ~Room() {}
};

