// =========================================================
//                  BASE CLASS : PERSON
// =========================================================
class Person {

protected:
    string name;
    string phone;
    string email;
    string country;
    string city;

public:

    Person() {

        name = "";
        phone = "";
        email = "";
        country = "";
        city = "";
    }

    virtual void inputPersonData() {

        cin.ignore();

        cout << "Enter Name: ";
        getline(cin, name);

        cout << "Enter Phone: ";
        getline(cin, phone);

        cout << "Enter Email: ";
        getline(cin, email);

        cout << "Enter Country: ";
        getline(cin, country);

        cout << "Enter City: ";
        getline(cin, city);
    }

    virtual void displayPersonData() {

        cout << left << setw(15)
             << "Name"
             << ": " << name << endl;

        cout << left << setw(15)
             << "Phone"
             << ": " << phone << endl;

        cout << left << setw(15)
             << "Email"
             << ": " << email << endl;

        cout << left << setw(15)
             << "Country"
             << ": " << country << endl;

        cout << left << setw(15)
             << "City"
             << ": " << city << endl;
    }

    virtual ~Person() {}
};

// =========================================================
//                  CUSTOMER CLASS
// =========================================================
class Customer : public Person {

protected:
    string idNumber;
    string nationality;

public:

    Customer() {

        idNumber = "";
        nationality = "";
    }

    void inputCustomerData() {

        inputPersonData();

        cout << "Enter Nationality: ";
        getline(cin, nationality);

        // =================================================
        // PAKISTANI CUSTOMER
        // =================================================
        if (nationality == "Pakistani" ||
            nationality == "pakistani" ||
            nationality == "PAKISTANI") {

            cout << "Enter CNIC: ";
            getline(cin, idNumber);
        }

        // =================================================
        // FOREIGN CUSTOMER
        // =================================================
        else {

            cout << "Enter Passport Number: ";
            getline(cin, idNumber);
        }
    }

    void displayCustomerData() {

        displayPersonData();

        cout << left << setw(15)
             << "Nationality"
             << ": " << nationality << endl;

        // =================================================
        // SHOW CNIC OR PASSPORT
        // =================================================
        if (nationality == "Pakistani" ||
            nationality == "pakistani" ||
            nationality == "PAKISTANI") {

            cout << left << setw(15)
                 << "CNIC"
                 << ": " << idNumber << endl;
        }

        else {

            cout << left << setw(15)
                 << "Passport"
                 << ": " << idNumber << endl;
        }
    }
};

// =========================================================
//                  ROOM ABSTRACT CLASS
// =========================================================
class Room {

protected:
    int roomNo;
    bool booked;
    int stayDays;

public:

    Room() {

        roomNo = 0;
        booked = false;
        stayDays = 0;
    }

    virtual void setRoom(int no) {

        roomNo = no;
    }

    virtual int getPrice() = 0;

    virtual string getRoomType() = 0;

    virtual void displayRoom() {

        cout << left << setw(15)
             << "Room Number"
             << ": " << roomNo << endl;

        cout << left << setw(15)
             << "Room Type"
             << ": " << getRoomType() << endl;

        cout << left << setw(15)
             << "Price"
             << ": " << getPrice() << endl;
    }

    bool isBooked() {

        return booked;
    }

    void bookRoom(int days) {

        booked = true;
        stayDays = days;
    }

    void checkoutRoom() {

        booked = false;
        stayDays = 0;
    }

    int getRoomNo() {

        return roomNo;
    }

    int getStayDays() {

        return stayDays;
    }

    virtual ~Room() {}
};

// =========================================================
//                  SINGLE ROOM
// =========================================================
class SingleRoom : public Room {

public:

    int getPrice() override {

        return 3000;
    }

    string getRoomType() override {

        return "Single Room";
    }
};

// =========================================================
//                  DOUBLE ROOM
// =========================================================
class DoubleRoom : public Room {

public:

    int getPrice() override {

        return 5000;
    }

    string getRoomType() override {

        return "Double Room";
    }
};

// =========================================================
//                  DELUXE ROOM
// =========================================================
class DeluxeRoom : public Room {

public:

    int getPrice() override {

        return 8000;
    }

    string getRoomType() override {

        return "Deluxe Room";
    }
};

// =========================================================
//                  FORWARD DECLARATION
// =========================================================
class Hotel;

// =========================================================
//                  BILL GENERATOR
// =========================================================
class BillGenerator {

public:

    static void generateBill(Hotel& h, int roomNo);
};

// =========================================================
//                  HOTEL CLASS
// =========================================================
class Hotel {

private:

    static const int TOTAL_ROOMS = 100;

    vector<Room*> rooms;
    vector<Customer> customers;

    vector<string> feedbacks;

    map<int, string> roomHistory;

public:

    Hotel() {

        customers.resize(TOTAL_ROOMS);

        for (int i = 0; i < TOTAL_ROOMS; i++) {

            if (i < 30)
                rooms.push_back(new SingleRoom());

            else if (i < 70)
                rooms.push_back(new DoubleRoom());

            else
                rooms.push_back(new DeluxeRoom());

            rooms[i]->setRoom(i + 1);
        }
    }

    // =====================================================
    // CHECK ROOM AVAILABILITY
    // =====================================================
    void checkAvailability() {

        cout << "\n========= AVAILABLE ROOMS =========\n";

        for (Room* r : rooms) {

            if (!r->isBooked()) {

                cout << left << setw(15)
                     << "Room No"
                     << ": " << r->getRoomNo() << endl;

                cout << left << setw(15)
                     << "Type"
                     << ": " << r->getRoomType() << endl;

                cout << left << setw(15)
                     << "Price"
                     << ": " << r->getPrice() << endl;

                cout << "----------------------------------\n";
            }
        }
    }

    // =====================================================
    // SMART ROOM RECOMMENDATION
    // =====================================================
    void smartRecommendation() {

        int budget;

        cout << "Enter Budget Per Day: ";
        cin >> budget;

        if (budget <= 3000)
            cout << "Recommended : Single Room\n";

        else if (budget <= 5000)
            cout << "Recommended : Double Room\n";

        else
            cout << "Recommended : Deluxe Room\n";
    }

    // =====================================================
    // ONLINE BOOKING
    // =====================================================
    void onlineBooking() {

        int roomNo;
        int days;

        cout << "Enter Room Number: ";
        cin >> roomNo;

        if (roomNo < 1 || roomNo > TOTAL_ROOMS) {

            cout << "Invalid Room Number\n";
            return;
        }

        if (rooms[roomNo - 1]->isBooked()) {

            cout << "Room Already Booked\n";
            return;
        }

        cout << "Enter Stay Days: ";
        cin >> days;

        customers[roomNo - 1].inputCustomerData();

        rooms[roomNo - 1]->bookRoom(days);

        roomHistory[roomNo] = "Booked";

        cout << "\nBooking Successful\n";
    }

    // =====================================================
    // CHECKOUT ROOM
    // =====================================================
    void checkoutRoom() {

        int roomNo;

        cout << "Enter Room Number: ";
        cin >> roomNo;

        if (roomNo < 1 || roomNo > TOTAL_ROOMS) {

            cout << "Invalid Room Number\n";
            return;
        }

        if (!rooms[roomNo - 1]->isBooked()) {

            cout << "Room Already Empty\n";
            return;
        }

        BillGenerator::generateBill(*this, roomNo);

        rooms[roomNo - 1]->checkoutRoom();

        roomHistory[roomNo] = "Checked Out";

        cout << "Checkout Successful\n";
    }

    // =====================================================
    // CUSTOMER DETAILS
    // =====================================================
    void customerDetails() {

        int roomNo;

        cout << "Enter Room Number: ";
        cin >> roomNo;

        if (roomNo < 1 || roomNo > TOTAL_ROOMS) {

            cout << "Invalid Room Number\n";
            return;
        }

        if (!rooms[roomNo - 1]->isBooked()) {

            cout << "No Customer Found\n";
            return;
        }

        customers[roomNo - 1].displayCustomerData();
    }

    // =====================================================
    // ADD FEEDBACK
    // =====================================================
    void addFeedback() {

        cin.ignore();

        string feedback;

        cout << "Enter Feedback: ";
        getline(cin, feedback);

        feedbacks.push_back(feedback);

        cout << "Feedback Added Successfully\n";
    }

    // =====================================================
    // SHOW FEEDBACKS
    // =====================================================
    void showFeedbacks() {

        cout << "\n========= CUSTOMER FEEDBACKS =========\n";

        int count = 1;

        for (string feedback : feedbacks) {

            cout << count << ". "
                 << feedback << endl;

            count++;
        }
    }

    // =====================================================
    // DISPLAY ALL ROOMS
    // =====================================================
    void displayAllRooms() {

        cout << "\n========= ALL ROOMS =========\n";

        for (Room* r : rooms) {

            r->displayRoom();

            if (r->isBooked())
                cout << "Status : Booked\n";

            else
                cout << "Status : Available\n";

            cout << "----------------------------------\n";
        }
    }

    // =====================================================
    // SORT ROOMS BY PRICE
    // =====================================================
    void sortRoomsByPrice() {

        sort(rooms.begin(), rooms.end(),

            [](Room* a, Room* b) {

                return a->getPrice() < b->getPrice();
            });

        cout << "\nRooms Sorted By Price Successfully\n";
    }

    // =====================================================
    // ROOM HISTORY
    // =====================================================
    void showRoomHistory() {

        cout << "\n========= ROOM HISTORY =========\n";

        for (auto data : roomHistory) {

            cout << "Room "
                 << data.first
                 << " -> "
                 << data.second
                 << endl;
        }
    }

    // =====================================================
    // FRIEND CLASS
    // =====================================================
    friend class BillGenerator;

    // =====================================================
    // DESTRUCTOR
    // =====================================================
    ~Hotel() {

        for (Room* r : rooms) {

            delete r;
        }
    }
};

// =========================================================
//                  BILL FUNCTION
// =========================================================
void BillGenerator::generateBill(Hotel& h, int roomNo) {

    Room* r = h.rooms[roomNo - 1];

    int total = r->getPrice() * r->getStayDays();

    cout << "\n====================================\n";
    cout << "             HOTEL BILL             \n";
    cout << "====================================\n";

    cout << left << setw(15)
         << "Room Number"
         << ": " << roomNo << endl;

    cout << left << setw(15)
         << "Room Type"
         << ": " << r->getRoomType() << endl;

    cout << left << setw(15)
         << "Price/Day"
         << ": " << r->getPrice() << endl;

    cout << left << setw(15)
         << "Stay Days"
         << ": " << r->getStayDays() << endl;

    cout << "------------------------------------\n";

    cout << left << setw(15)
         << "Total Bill"
         << ": " << total << " PKR\n";

    cout << "====================================\n";
}

