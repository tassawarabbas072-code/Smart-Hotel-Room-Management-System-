// =========================================================
int main()
{
    if (!login())
    {
        return 0;
    }

    Hotel h;

    int choice;

    do {

        menu();

        cout << "Enter Choice: ";
        cin >> choice;

        switch (choice) {

        case 1:
            h.roomStatus();
            break;

        case 2:
            h.roomBooking();
            break;

        case 3:
            h.checkoutRoom();
            break;

        case 4:
            h.customerDetails();
            break;

        case 5:
            cout << "Thank You For Using System\n";
            break;

        default:
            cout << "Invalid Choice\n";
        }

    } while (choice != 5);

    return 0;
}

