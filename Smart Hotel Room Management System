//                  FORWARD DECLARATION
// =========================================================
class Hotel;

// =========================================================
//                  BILL GENERATOR
// =========================================================
class BillGenerator {

public:

    static void generateBill(Hotel& h, int roomNo);
};

// =========================================================
//                  HOTEL CLASS
// =========================================================
class Hotel {

private:

    static const int TOTAL_ROOMS = 10;

    vector<Room*> rooms;
    vector<Customer> customers;

public:

    Hotel() {

        customers.resize(TOTAL_ROOMS);

        for (int i = 0; i < TOTAL_ROOMS; i++) {

            if (i < 3)
                rooms.push_back(new SingleRoom());

            else if (i < 7)
                rooms.push_back(new DoubleRoom());

            else
                rooms.push_back(new DeluxeRoom());

            rooms[i]->setRoom(i + 1);
        }
    }

    // =====================================================
    // ROOM STATUS
    // =====================================================
    void roomStatus() {

        cout << "\n====================================================================\n";

        cout << left
             << setw(10) << "Room No"
             << setw(15) << "Room Type"
             << setw(10) << "Price"
             << setw(15) << "Status"
             << setw(15) << "Book Date"
             << endl;

        cout << "====================================================================\n";

        for (Room* r : rooms) {

            cout << left
                 << setw(10) << r->getRoomNo()
                 << setw(15) << r->getRoomType()
                 << setw(10) << r->getPrice();

            if (r->isBooked()) {

                cout << setw(15) << "Booked"
                     << setw(15) << r->getBookingDate();
            }

            else {

                cout << setw(15) << "Available"
                     << setw(15) << "-";
            }

            cout << endl;
        }
    }

    // =====================================================
    // ROOM BOOKING
    // =====================================================
    void roomBooking() {

        int roomNo;
        int days;
        string date;

        cout << "Enter Room Number: ";
        cin >> roomNo;

        if (roomNo < 1 || roomNo > TOTAL_ROOMS) {

            cout << "Invalid Room Number\n";
            return;
        }

        if (rooms[roomNo - 1]->isBooked()) {

            cout << "Room Already Booked\n";
            return;
        }

        cout << "Enter Stay Days: ";
        cin >> days;

        cin.ignore();

        date = getCurrentDate();
        string day  = getCurrentDay();

        customers[roomNo - 1].inputCustomerData();

        rooms[roomNo - 1]->bookRoom(days, date);

        cout << "\n====================================\n";
        cout << "     ROOM BOOKED SUCCESSFULLY\n";
        cout << "====================================\n";

        cout << "Booking Date : "
        << date << endl;

        cout << "Booking Day  : "
        << day << endl;
    }

    // =====================================================
    // CHECKOUT ROOM
    // =====================================================
    void checkoutRoom() {

        int roomNo;

        cout << "Enter Room Number: ";
        cin >> roomNo;

        if (roomNo < 1 || roomNo > TOTAL_ROOMS) {

            cout << "Invalid Room Number\n";
            return;
        }

        if (!rooms[roomNo - 1]->isBooked()) {

            cout << "Room Already Empty\n";
            return;
        }

        BillGenerator::generateBill(*this, roomNo);

        rooms[roomNo - 1]->checkoutRoom();

        cout << "Checkout Successful\n";
    }

    // =====================================================
    // CUSTOMER DETAILS
    // =====================================================
    void customerDetails() {

        int roomNo;

        cout << "Enter Room Number: ";
        cin >> roomNo;

        if (roomNo < 1 || roomNo > TOTAL_ROOMS) {

            cout << "Invalid Room Number\n";
            return;
        }

        if (!rooms[roomNo - 1]->isBooked()) {

            cout << "No Customer Found\n";
            return;
        }

        customers[roomNo - 1].displayCustomerData();
    }

    // =====================================================
    // FRIEND CLASS
    // =====================================================
    friend class BillGenerator;

    // =====================================================
    // DESTRUCTOR
    // =====================================================
    ~Hotel() {

        for (Room* r : rooms) {

            delete r;
        }
    }
};

// =========================================================
//                  BILL FUNCTION
// =========================================================
void BillGenerator::generateBill(Hotel& h, int roomNo) {

    Room* r = h.rooms[roomNo - 1];

    int roomCharges =
        r->getPrice() * r->getStayDays();

    int serviceCharges = 1000;

    int total =
        roomCharges + serviceCharges;

    cout << "\n====================================\n";
    cout << "             HOTEL BILL             \n";
    cout << "====================================\n";

    cout << left << setw(15)
         << "Room Number"
         << ": " << roomNo << endl;

    cout << left << setw(15)
         << "Room Type"
         << ": " << r->getRoomType() << endl;

    cout << left << setw(15)
         << "Price/Day"
         << ": " << r->getPrice() << endl;

    cout << left << setw(15)
         << "Stay Days"
         << ": " << r->getStayDays() << endl;

    cout << left << setw(15)
         << "Booking Date"
         << ": " << r->getBookingDate() << endl;

    cout << left << setw(15)
         << "Service Fee"
         << ": " << serviceCharges << endl;

    cout << "------------------------------------\n";

    cout << left << setw(15)
         << "Total Bill"
         << ": " << total << " PKR\n";

    cout << "====================================\n";
}

bool login()
{
    string username;
    string password;

    int attempts = 3;

    while (attempts > 0)
    {
        cout << "\n========================================\n";
        cout << "            ADMIN LOGIN\n";
        cout << "========================================\n";

        cout << "Username: ";
        cin >> username;

        cout << "Password: ";
        cin >> password;

        if (username == "admin" &&
            password == "1234")
        {
            cout << "\nLogin Successful!\n";
            return true;
        }

        attempts--;

        cout << "\nInvalid Login!\n";
        cout << "Remaining Attempts: "
             << attempts << endl;
    }

    cout << "\nSystem Locked!\n";
    return false;
}


